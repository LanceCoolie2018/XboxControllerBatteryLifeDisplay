<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BatteryHUD.Views.DevicePickerWindow"
        Title="Choose device"
        Width="420" Height="420"
        MinWidth="320" MinHeight="280"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="Full"
        TransparencyLevelHint="AcrylicBlur"
        Background="#F01E1E1E">

  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top"
               Text="Choose device"
               FontSize="18"
               FontWeight="SemiBold"
               Margin="0,0,0,4" />
    <TextBlock DockPanel.Dock="Top"
               Text="Paired Bluetooth and HID devices are listed even when Windows does not report a battery percentage (shown as “Battery not reported” / N/A). Pick the device you want on the HUD — you can switch anytime."
               TextWrapping="Wrap"
               Opacity="0.75"
               Margin="0,0,0,12" />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Refresh" Click="OnRefresh" />
      <Button Content="Clear" Click="OnClear" ToolTip.Tip="No preferred device — HUD picks a controller if available" />
      <Button Content="Cancel" Click="OnCancel" />
      <Button Content="Use selected" Click="OnConfirm" IsDefault="True" />
    </StackPanel>

    <ListBox x:Name="DeviceList"
             DoubleTapped="OnDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="*,Auto" Margin="4,6">
            <StackPanel Grid.Column="0">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Subtitle}" Opacity="0.7" FontSize="12" />
            </StackPanel>
            <TextBlock Grid.Column="1"
                       Text="{Binding PercentDisplay}"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       ToolTip.Tip="{Binding StatusText}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
