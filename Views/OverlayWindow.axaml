<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BatteryHUD.Views.OverlayWindow"
        Title="BatteryHUD"
        Width="320" Height="58"
        MinWidth="260" MinHeight="50"
        CanResize="False"
        SystemDecorations="None"
        Topmost="False"
        ShowInTaskbar="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0">

  <Border x:Name="RootBorder"
          Background="#CC1A1A1A"
          CornerRadius="10"
          BorderBrush="#55FFFFFF"
          BorderThickness="1"
          Padding="8,6"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased"
          ToolTip.Tip="Drag to move · Switch · Dup · Time · Bug · Exit">
    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
      <TextBlock x:Name="PercentText"
                 Grid.Row="0" Grid.Column="0"
                 Text="--%"
                 FontSize="20"
                 FontWeight="Bold"
                 Foreground="#42A5F5"
                 VerticalAlignment="Center" />

      <StackPanel Grid.Row="0" Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="3"
                  Margin="4,0,0,0"
                  VerticalAlignment="Center">
        <Button x:Name="PinButton"
                Content="Pin"
                Padding="6,2"
                FontSize="11"
                Click="OnPinClick"
                ToolTip.Tip="Toggle always on top (off by default; uses standard window Topmost)" />
        <Button x:Name="SwitchButton"
                Content="Switch"
                Padding="6,2"
                FontSize="11"
                Click="OnSwitchClick"
                ToolTip.Tip="Choose a paired Bluetooth or HID device (battery % shown when Windows reports it)" />
        <Button x:Name="DupButton"
                Content="Dup"
                Padding="6,2"
                FontSize="11"
                Click="OnDupClick"
                ToolTip.Tip="Open another widget to monitor a second device at the same time" />
        <Button x:Name="TimeButton"
                Content="Time"
                Padding="6,2"
                FontSize="11"
                Click="OnTimeClick"
                ToolTip.Tip="Open a draggable hologram clock (Digital or Grandfather style)" />
        <Button x:Name="BugButton"
                Content="Bug"
                Padding="6,2"
                FontSize="11"
                Click="OnBugClick"
                ToolTip.Tip="Report a bug — opens GitHub (or local UserReport in dev)" />
        <Button x:Name="ExitButton"
                Content="Exit"
                Padding="6,2"
                FontSize="11"
                Click="OnExitClick"
                ToolTip.Tip="Close this widget (last one exits the app)" />
      </StackPanel>

      <!-- Compact: device name + connection / battery status -->
      <TextBlock x:Name="DeviceText"
                 Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                 Text="No device"
                 FontSize="10"
                 Foreground="#CCFFFFFF"
                 TextTrimming="CharacterEllipsis"
                 Margin="0,2,0,0"
                 ToolTip.Tip="Switch lists paired Bluetooth/HID devices. N/A means Windows has no battery % for that device." />
    </Grid>
  </Border>
</Window>
