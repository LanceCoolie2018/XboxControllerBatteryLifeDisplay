<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BatteryHUD.Views.OverlayWindow"
        Title="BatteryHUD"
        Width="248" Height="58"
        MinWidth="200" MinHeight="50"
        CanResize="False"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0">

  <Border x:Name="RootBorder"
          Background="#CC1A1A1A"
          CornerRadius="10"
          BorderBrush="#55FFFFFF"
          BorderThickness="1"
          Padding="8,6"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased"
          ToolTip.Tip="Drag to move · Switch · Bug · Exit">
    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
      <TextBlock x:Name="PercentText"
                 Grid.Row="0" Grid.Column="0"
                 Text="--%"
                 FontSize="22"
                 FontWeight="Bold"
                 Foreground="#42A5F5"
                 VerticalAlignment="Center" />

      <StackPanel Grid.Row="0" Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="3"
                  Margin="4,0,0,0"
                  VerticalAlignment="Center">
        <Button x:Name="SwitchButton"
                Content="Switch"
                Padding="6,2"
                FontSize="11"
                Click="OnSwitchClick"
                ToolTip.Tip="Choose which battery-powered device to watch" />
        <Button x:Name="BugButton"
                Content="Bug"
                Padding="6,2"
                FontSize="11"
                Click="OnBugClick"
                ToolTip.Tip="Report a bug — adds an open item to UserReport.md" />
        <Button x:Name="ExitButton"
                Content="Exit"
                Padding="6,2"
                FontSize="11"
                Click="OnExitClick"
                ToolTip.Tip="Close BatteryHUD" />
      </StackPanel>

      <!-- Compact: device name + connected/disconnected only (no kind/charging/hints) -->
      <TextBlock x:Name="DeviceText"
                 Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                 Text="No device"
                 FontSize="10"
                 Foreground="#CCFFFFFF"
                 TextTrimming="CharacterEllipsis"
                 Margin="0,2,0,0"
                 ToolTip.Tip="Click Switch to pick a controller, mouse, or any battery device" />
    </Grid>
  </Border>
</Window>
