<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BatteryHUD.Views.HologramClockWindow"
        Title="BatteryHUD Time"
        Width="280" Height="100"
        MinWidth="220" MinHeight="90"
        CanResize="False"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0">

  <!--
    3D hologram look: dark-red glass plate + gold labels + RGB-offset ghost digits + soft scan-line band.
    Time digits use dark red (not bright white); HOLO TIME / date / close use crisp gold.
    Drag anywhere except the X button; position is saved.
  -->
  <Border x:Name="RootBorder"
          Background="#33141010"
          CornerRadius="12"
          BorderBrush="#88C8A020"
          BorderThickness="1.5"
          BoxShadow="0 0 18 2 #55A01828"
          Padding="14,10,14,12"
          PointerPressed="OnPointerPressed"
          PointerMoved="OnPointerMoved"
          PointerReleased="OnPointerReleased"
          ToolTip.Tip="Hologram clock · drag to move · X to close">
    <Grid>
      <!-- Subtle top-to-bottom hologram sheen -->
      <Border CornerRadius="10"
              IsHitTestVisible="False"
              Opacity="0.35">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#55C8A020" Offset="0" />
            <GradientStop Color="#00000000" Offset="0.45" />
            <GradientStop Color="#33801820" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- Soft scan-line band (animated in code-behind) -->
      <Border x:Name="ScanBand"
              Height="10"
              VerticalAlignment="Top"
              Margin="2,4,2,0"
              CornerRadius="2"
              IsHitTestVisible="False"
              Opacity="0.25">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#00000000" Offset="0" />
            <GradientStop Color="#AAE8C84A" Offset="0.5" />
            <GradientStop Color="#00000000" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <Grid RowDefinitions="Auto,*,Auto">
        <!-- Title row + close -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,2">
          <TextBlock Text="HOLO TIME"
                     FontSize="9"
                     FontWeight="SemiBold"
                     LetterSpacing="2"
                     Foreground="#E8C84A"
                     VerticalAlignment="Center" />
          <Button x:Name="CloseButton"
                  Grid.Column="1"
                  Content="✕"
                  Padding="6,0"
                  FontSize="11"
                  MinWidth="22"
                  MinHeight="18"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="#E8C84A"
                  Click="OnCloseClick"
                  ToolTip.Tip="Close hologram clock" />
        </Grid>

        <!-- Time: layered chromatic ghosts under dark-red digits -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0">
          <!-- Deep crimson ghost (depth left) -->
          <TextBlock x:Name="TimeGhostMagenta"
                     Text="--:--"
                     FontSize="36"
                     FontWeight="Bold"
                     FontFamily="Consolas, Courier New, monospace"
                     Foreground="#66501018"
                     HorizontalAlignment="Center"
                     IsHitTestVisible="False"
                     Margin="-2,1,0,0" />
          <!-- Warm gold ghost (depth right) -->
          <TextBlock x:Name="TimeGhostCyan"
                     Text="--:--"
                     FontSize="36"
                     FontWeight="Bold"
                     FontFamily="Consolas, Courier New, monospace"
                     Foreground="#66C8A020"
                     HorizontalAlignment="Center"
                     IsHitTestVisible="False"
                     Margin="2,-1,0,0" />
          <!-- Main hologram digits — dark red (not bright white) -->
          <TextBlock x:Name="TimeText"
                     Text="--:--"
                     FontSize="36"
                     FontWeight="Bold"
                     FontFamily="Consolas, Courier New, monospace"
                     Foreground="#8B1515"
                     HorizontalAlignment="Center" />
        </Grid>

        <!-- Date / seconds line -->
        <TextBlock x:Name="DateText"
                   Grid.Row="2"
                   Text=""
                   FontSize="11"
                   FontFamily="Consolas, Courier New, monospace"
                   Foreground="#F0C53A"
                   HorizontalAlignment="Center"
                   Margin="0,2,0,0" />
      </Grid>
    </Grid>
  </Border>
</Window>
