<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Partner Center App identity (must match exactly) -->
  <Identity
    Name="LanceCoolie.BatteryHUD"
    Publisher="CN=38612EE3-4B41-491B-A977-4F01F5A3F473"
    Version="1.0.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>BatteryHUD</DisplayName>
    <PublisherDisplayName>LanceCoolie</PublisherDisplayName>
    <Description>Battery overlay for controllers, mice, and other peripherals. Optional always-on-top; lists paired devices even when battery % is not reported by Windows.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="BatteryHUD.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="BatteryHUD"
        Description="Battery overlay HUD for game controllers and peripherals. Optional pin-on-top; shows Battery not reported when Windows has no charge data."
        BackgroundColor="#1E1E1E"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"
                         Square71x71Logo="Assets\Square44x44Logo.png"
                         ShortName="BatteryHUD" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1E1E1E" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <!--
    runFullTrust: required for desktop bridge (.NET/Avalonia Win32 + WMI).
    Not used for always-on-top (that is Window.Topmost, off by default).
    Declare as full-trust desktop app in Partner Center if prompted.
  -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
